{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bikeanjo/ai2tcs/extract/1",
  "title": "POST /extract e POST /extract-multi",
  "description": "Extração de campo(s) da resposta livre no Zap (em produção): onboarding, reply_intent e correção de boleto. Cliente: zapzap/lib/llm-remote.js (extractFromReply, extractMultiField). Sem valor extraído → null; o bot pergunta de novo.",
  "$defs": {
    "request_single": {
      "type": "object",
      "required": [
        "task",
        "step",
        "question",
        "userReply"
      ],
      "properties": {
        "task": {
          "const": "extract"
        },
        "step": {
          "type": "string",
          "description": "Known steps: interesse, nome, cpf, email, nascimento, cep, reply_intent, payment_boleto_confirmation. Unknown step → extracted null."
        },
        "question": {
          "type": "string"
        },
        "userReply": {
          "type": "string"
        }
      }
    },
    "response_single": {
      "type": "object",
      "properties": {
        "extracted": {
          "description": "string com o valor extraído (código reply_intent, campo de onboarding, ou JSON string no passo payment_boleto_confirmation)",
          "type": [
            "string",
            "object",
            "null"
          ]
        }
      }
    },
    "request_multi": {
      "type": "object",
      "required": [
        "task",
        "userReply",
        "fields"
      ],
      "properties": {
        "task": {
          "const": "extract_multi"
        },
        "userReply": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "example": {
                "type": "string"
              }
            }
          }
        },
        "context": {
          "type": "object"
        }
      }
    },
    "response_multi": {
      "type": "object",
      "properties": {
        "extracted": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
