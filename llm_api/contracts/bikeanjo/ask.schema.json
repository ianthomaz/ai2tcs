{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bikeanjo/ai2tcs/ask/1",
  "title": "POST /ask (+ GET /status/{job_id}, GET /result/{job_id})",
  "description": "Resposta livre com RAG do projeto (em produção). Assíncrono: /ask devolve job_id; o bot consulta /status a cada 2,5 s até um estado final e busca /result. Silêncio (no_answer, answer vazio) é resultado válido (10d P6). Contrato em prosa: docs/10d § 3. Cliente: zapzap/lib/llm-remote.js (_ask, ASK_CONTEXT_KEYS, ASK_TERMINAL_STATUSES).",
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "project_id",
        "question"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "system_prompt": {
          "type": "string"
        },
        "user_context": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "birth_date": {
              "type": "string"
            },
            "cep": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "health": {
              "type": "string"
            },
            "current_time": {
              "type": "string"
            },
            "interesse": {
              "type": "string"
            },
            "clearance": {
              "type": "string"
            },
            "intended_clearance": {
              "type": "string"
            },
            "journey_kind": {
              "type": "string"
            },
            "journey_destination": {
              "type": "string"
            },
            "next_event_name": {
              "type": "string"
            },
            "next_event_at": {
              "type": "string"
            },
            "registered": {
              "type": "boolean"
            }
          },
          "description": "o bot só manda as chaves de ASK_CONTEXT_KEYS + registered; vazias não vão"
        }
      }
    },
    "job_created": {
      "type": "object",
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        }
      }
    },
    "job_status": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "description": "qualquer outro valor = ainda rodando"
        }
      }
    },
    "terminal_status": {
      "enum": [
        "done",
        "no_answer",
        "need_more_info",
        "failed",
        "cancelled"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "answer": {
          "type": [
            "string",
            "null"
          ],
          "description": "final, já no formato WhatsApp: curto, link-first, sem markdown, sem preâmbulo. Em knowledge_kind=user_system preferir null — o cliente executa a action."
        },
        "intent": {
          "type": [
            "object",
            "null"
          ],
          "description": "2º roteador semântico do /ask (aditivo). Presente quando config_json.ask_intent.enabled. O cliente lê action e executa consulta; a LLM não lê banco.",
          "required": [
            "knowledge_kind"
          ],
          "properties": {
            "knowledge_kind": {
              "enum": [
                "org_general",
                "user_system",
                "unknown"
              ]
            },
            "action": {
              "type": [
                "string",
                "null"
              ],
              "description": "Código da lista fechada do projeto (ask_intent.actions) se user_system; senão null"
            },
            "action_payload": {
              "type": [
                "object",
                "null"
              ],
              "description": "Opcional: event_name / event_id se o modelo inferir do histórico"
            }
          }
        },
        "signals": {
          "type": [
            "object",
            "null"
          ],
          "description": "O que o serviço sabe da resposta — não é opinião do modelo. Aditivo: cliente que não lê não muda. ai2tcs docs/19 § 7 (L1).",
          "properties": {
            "best_distance": {
              "type": [
                "number",
                "null"
              ],
              "description": "distância do melhor trecho da base (menor = mais perto)"
            },
            "chunks_kept": {
              "type": "integer",
              "description": "trechos que passaram do limiar"
            },
            "sanitize_hit": {
              "type": "boolean",
              "description": "a limpeza de frase proibida mexeu no texto"
            },
            "guard_hit": {
              "type": "boolean",
              "description": "a trava do projeto (forbidden_terms) mexeu no texto"
            },
            "reflection_changed": {
              "type": "boolean",
              "description": "só /ask: a revisão de fundamentação trocou o texto"
            },
            "answer_chars": {
              "type": "integer"
            },
            "prompt_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "near_ctx_limit": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "o prompt chegou a 90% da janela de contexto"
            }
          }
        }
      }
    }
  }
}
