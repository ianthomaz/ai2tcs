{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text-triage.schema.json",
  "title": "POST /task/text_triage — triagem de texto que chega (porta genérica do ai2tcs, docs/20)",
  "description": "Tarefa de arquivo do ai2tcs, igual para todo projeto. As categorias são do projeto (config_json.tasks.text_triage.categories no ai2tcs); a lista abaixo é a do Bike Anjo e tem de ser a mesma do seed do ai2tcs.",
  "$defs": {
    "category": {
      "enum": ["bike_anjo_request", "volunteering", "partnership", "press", "event", "support", "other"]
    },
    "urgency": { "enum": ["none", "watch", "urgent"] },
    "request": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "subject": { "type": ["string", "null"], "maxLength": 500 },
        "channel": { "enum": ["email", "form", "ticket", "chat", "other"] },
        "sender_known": { "type": ["boolean", "null"] }
      }
    },
    "response_ok": {
      "type": "object",
      "required": ["status", "urgency", "priority", "category", "summary", "needs_reply", "confidence", "model", "prompt_version"],
      "properties": {
        "status": { "const": "ok" },
        "urgency": { "$ref": "#/$defs/urgency" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "category": { "$ref": "#/$defs/category" },
        "summary": { "type": "string", "maxLength": 240 },
        "needs_reply": { "type": "boolean" },
        "suggested_project": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "model": { "type": "string" },
        "prompt_version": { "const": "text-triage-v1" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "response_error": { "$ref": "common.schema.json#/$defs/error" }
  }
}
