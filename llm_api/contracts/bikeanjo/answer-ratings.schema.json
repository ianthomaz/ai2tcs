{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "answer-ratings.schema.json",
  "title": "POST /ratings · GET /ratings/proposals · POST /ratings/proposals/{id}/decision (ai2tcs docs/22)",
  "description": "Julgamentos do /adm/shadow-llm para o ai2tcs. Porta genérica: vale para qualquer projeto. Termo proibido proposto só vale depois de aprovado.",
  "$defs": {
    "item": {
      "type": "object",
      "required": ["source_ref", "rating"],
      "additionalProperties": false,
      "properties": {
        "source_ref": { "type": "string", "pattern": "^[A-Za-z0-9:._-]{1,120}$", "description": "zap:log:<id do debug log>" },
        "rating": { "enum": ["stop", "bad", "good", "great", null], "description": "null = a pessoa desfez a nota" },
        "question": { "type": "string", "maxLength": 4000 },
        "answer": { "type": "string", "maxLength": 4000, "description": "«ótima» com texto ajustado: o texto da pessoa" },
        "reason": { "type": ["string", "null"], "maxLength": 500 },
        "signals": { "type": "object", "description": "bloco signals do /ask (ou do /router)" },
        "suggested_terms": { "type": "array", "items": { "type": "string", "minLength": 3, "maxLength": 200 } },
        "rated_at": { "type": "string", "format": "date-time" }
      }
    },
    "request": {
      "type": "object",
      "required": ["items"],
      "properties": { "items": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/item" } } }
    },
    "response_ok": {
      "type": "object",
      "required": ["status", "stored", "removed", "new_proposals"],
      "properties": {
        "status": { "const": "ok" },
        "stored": { "type": "integer" },
        "removed": { "type": "integer" },
        "new_proposals": { "type": "integer" }
      }
    },
    "proposal": {
      "type": "object",
      "required": ["id", "kind", "value", "source_refs", "status"],
      "properties": {
        "id": { "type": "integer" },
        "kind": { "enum": ["forbidden_term"] },
        "value": { "type": "string" },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["pending", "approved", "rejected"] },
        "created_at": { "type": ["string", "null"] },
        "decided_at": { "type": ["string", "null"] },
        "decided_by": { "type": ["string", "null"] }
      }
    },
    "decision_request": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": { "enum": ["approve", "reject"] },
        "decided_by": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
