{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bikeanjo/ai2tcs/common/1",
  "title": "Envelope comum das portas de texto",
  "description": "docs/10h_ai2tcs_portas_de_texto.md § 1. Erro de conteúdo é HTTP 200 com corpo de erro; 401/429/5xx só para transporte. `error` é o envelope das portas novas; `legacy_error` é o das portas de documento (/nfExtract, /boletoExtract), que continua valendo até elas ganharem `error` ao lado — ver README § Padrão comum.",
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "status",
        "error"
      ],
      "properties": {
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "timeout",
                "model_error",
                "unauthorized"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "legacy_error": {
      "type": "object",
      "required": [
        "status",
        "errors"
      ],
      "properties": {
        "status": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Mensagem legível em português; o cliente mostra errors[0]."
        }
      }
    }
  }
}
