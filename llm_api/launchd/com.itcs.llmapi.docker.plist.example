<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Production LLM API (Docker Compose) — autostart at login.

  1. Docker Desktop: Settings → General → "Open Docker Desktop when you sign in".
  2. chmod +x scripts/llm_docker_autostart.sh
  3. cp launchd/com.itcs.llmapi.docker.plist.example ~/Library/LaunchAgents/com.itcs.llmapi.docker.plist
  4. Edit plist: fix paths if your llm_api root is not /Users/ianthomaz/Documents/projects/ai2tcs/llm_api
  5. launchctl load ~/Library/LaunchAgents/com.itcs.llmapi.docker.plist

  If you still use the old uvicorn-only plist (com.itcs.llmapi.plist), unload it to avoid port 28471 conflict:
    launchctl unload ~/Library/LaunchAgents/com.itcs.llmapi.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.itcs.llmapi.docker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ianthomaz/Documents/projects/ai2tcs/llm_api/scripts/llm_docker_autostart.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ianthomaz/Documents/projects/ai2tcs/llm_api/logs/llmapi-docker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ianthomaz/Documents/projects/ai2tcs/llm_api/logs/llmapi-docker.err.log</string>
</dict>
</plist>
