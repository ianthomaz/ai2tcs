# API
# Docker Compose sets TZ=America/Sao_Paulo for api + postgres (logs / local NOW() in SQL sessions).
# Accept tailnet IP access (peers connect to llm_server by tailnet IP, e.g. http://100.x.x.x:28471)
API_HOST=0.0.0.0
API_PORT=28471
# Token estável: gerado uma vez no primeiro setup; use o mesmo em todos os clientes (zapzap, servidores). Não regenere em deploy.
# Se precisar gerar: openssl rand -hex 24
LLM_API_TOKEN=

# --- Dashboard: Google OAuth (recommended) ---
# 1) GCP: OAuth client type "Web application". Never commit real Client Secret to git.
# 2) Authorized JavaScript origins = same scheme+host you open in the browser (e.g. https://llm.webplace.cc).
# 3) Authorized redirect URI must match EXACTLY (one line per origin you use):
#      {DASHBOARD_OAUTH_REDIRECT_BASE}/dashboard/auth/google/callback
# 4) Here: same origin as (2), no trailing slash.
# DASHBOARD_OAUTH_REDIRECT_BASE=http://127.0.0.1:28471
# DASHBOARD_OAUTH_REDIRECT_BASE=https://llm.webplace.cc
# DASHBOARD_GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# DASHBOARD_GOOGLE_CLIENT_SECRET=<paste client secret from GCP OAuth client; never commit>
# 5) REQUIRED for Google login to succeed: at least one email (lowercase). Empty allowlist rejects everyone.
# DASHBOARD_ALLOWED_EMAILS=ops@example.com,other@example.com

# Optional legacy HTML login (only if Google OAuth vars above are NOT all set)
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=

# Ops / tailnet — local-only/docs/LLM_SERVER_URLS.md
# LLM_TAILNET_SERVE_HTTPS_ORIGIN=https://<node>.<tailnet>.ts.net
# SSH reverse tunnel (llm_api/scripts/llm-tunnel-api-host-to-itcsvm.sh):
# ITCSVM_IP=
# ITCSVM_USER=opc
# SSH_KEY=$HOME/.ssh/your_key

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/llmapi

# Ollama: use 127.0.0.1 only when running uvicorn on the host. Docker Compose api service
# overrides OLLAMA_HOST to http://host.docker.internal:11434 (see docker-compose.yml).
# OLLAMA_HOST=http://127.0.0.1:11434
# Dual LLM: fast (router, summary, extract) vs smart (RAG, NF). Defaults: llama3:8b / gemma3:12b
# OLLAMA_FAST_MODEL=llama3:8b
# OLLAMA_COMPACT_MODEL=qwen2.5:7b-instruct
# OLLAMA_SMART_MODEL=gemma3:12b
# OLLAMA_REASONER_MODEL=deepseek-r1:14b
# OLLAMA_CHAT_MODEL=gemma3:12b
# NF Extract: max seconds waiting for Ollama /api/chat (clients should use ITCS_NF_EXTRACT_TIMEOUT_MS > this + ~30s)
# NF_EXTRACT_OLLAMA_TIMEOUT_S=120

# POST /edu/chat — default model alias + output cap (aliases: fast | compact | smart | reasoner)
# reasoner = DeepSeek R1 (mais lento; bom para explicações densas / mandarim avançado)
# EDU_CHAT_DEFAULT_MODEL_ALIAS=fast
# EDU_CHAT_NUM_PREDICT=512
# EDU_CHAT_RETRY_NUM_PREDICT=640
# EDU_CHAT_TEMPERATURE=0.55
# EDU_CHAT_RETRY_TEMPERATURE=0.28

# POST /nabilvideomap/qualify-caption — nabilVideoMap cataloguing (sync; output token budget)
# NABIL_QUALIFY_NUM_PREDICT=1536
# NABIL_QUALIFY_NUM_PREDICT_HARD_MAX=2048
# NABIL_QUALIFY_RAG_CONTEXT_MAX_CHARS=8000
# Ollama temperature (0.1–0.85): default 0.42 — higher reduces “same opener” clichés; too high may hurt JSON stability
# NABIL_QUALIFY_TEMPERATURE=0.42

# Dashboard /usage — referência em GiB para o arco “memória Ollama vs máquina” (ex.: 32 no Mac)
# DASHBOARD_OLLAMA_MEMORY_REFERENCE_GIB=32

# Paths (relative to llm_api or absolute)
DATA_DIR=./data

# Local STT (Whisper / faster-whisper) — POST /audio/transcribe, /audio/ask
# WHISPER_ENABLED=true
# WHISPER_MODEL_SIZE=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=pt
# WHISPER_BEAM_SIZE=5
# WHISPER_VAD_FILTER=true
# WHISPER_DOWNLOAD_ROOT=/absolute/path/to/whisper/cache
# AUDIO_MAX_BYTES=26214400
# AUDIO_TEMP_SUBDIR=audio_tmp

# External LLM providers — desativados por padrão. Deixar vazio = usar apenas Ollama.
# Ativar por projeto via config_json: {"llm_provider": "openai"} (ou "anthropic", "gemini")
# Ver app/llm/external_provider.py para documentação completa.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_DEFAULT_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5-20251001
# GEMINI_API_KEY=AIza...
# GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Optional: override library path for a project (sources = content + flow map)
# BIKEANJOALL_2026_SOURCES=/path/to/2026b_bikeanjoAll_dbPrisma/bibliotecaConteudoLLM,/path/to/2026b_bikeanjoAll_dbPrisma/mapaFluxosLLM
# WEBPLACECC_SOURCES=/path/to/webplacecc/bibliotecaLLM_webplacecc,/path/to/webplacecc/mapaFluxosLLM
# Webplace internal: dev notes + batch tools — default paths in seed_webplace.py under llm_api/project_library/webplace/
# WEBPLACE_SOURCES=/abs/path/fluxosLLM,/abs/path/bibliotecaConteudoLLM
# Chinese Learning (chineseLearning repo): markdown RAG
# CHINESE_LEARNING_SOURCES=/Users/you/Documents/projects/chineseLearning/rag_knowledge


# Runtime feature flags (safe defaults = false; keep current behavior)
# RAG_RERANK_ENABLED=false
# RAG_HYBRID_ENABLED=false
# ASK_STREAM_ENABLED=false
# EMBEDDING_CACHE_ENABLED=false
# REQUEST_LOGGING_ENABLED=true
