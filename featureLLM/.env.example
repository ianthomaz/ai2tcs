# API
# Docker Compose sets TZ=America/Sao_Paulo for api + postgres (logs / local NOW() in SQL sessions).
# Accept tailnet IP access (servers in tailnet connect to Mac by IP, e.g. http://100.90.214.92:28471)
API_HOST=0.0.0.0
API_PORT=28471
# Token estável: gerado uma vez no primeiro setup; use o mesmo em todos os clientes (zapzap, servidores). Não regenere em deploy.
# Se precisar gerar: openssl rand -hex 24
LLM_API_TOKEN=

# Dashboard login (user/password, not API token)
DASHBOARD_USER=ianthomaz
DASHBOARD_PASSWORD=2580

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/llmapi

# Ollama (default local). Docker: http://host.docker.internal:11434
# OLLAMA_HOST=http://127.0.0.1:11434
# Dual LLM: fast (router, summary, extract) vs smart (RAG, NF). Defaults: llama3:8b / qwen2.5:14b-instruct
# OLLAMA_FAST_MODEL=llama3:8b
# OLLAMA_COMPACT_MODEL=qwen2.5:7b-instruct
# OLLAMA_SMART_MODEL=qwen2.5:14b-instruct
# OLLAMA_REASONER_MODEL=deepseek-r1:8b
# NF Extract: max seconds waiting for Ollama /api/chat (clients should use ITCS_NF_EXTRACT_TIMEOUT_MS > this + ~30s)
# NF_EXTRACT_OLLAMA_TIMEOUT_S=120

# POST /edu/chat — default model alias + output cap (aliases: fast | compact | smart | reasoner)
# reasoner = DeepSeek R1 (mais lento; bom para explicações densas / mandarim avançado)
# EDU_CHAT_DEFAULT_MODEL_ALIAS=fast
# EDU_CHAT_NUM_PREDICT=512
# EDU_CHAT_RETRY_NUM_PREDICT=640
# EDU_CHAT_TEMPERATURE=0.55
# EDU_CHAT_RETRY_TEMPERATURE=0.28

# POST /nabilvideomap/qualify-caption — nabilVideoMap cataloguing (sync; output token budget)
# NABIL_QUALIFY_NUM_PREDICT=1536
# NABIL_QUALIFY_NUM_PREDICT_HARD_MAX=2048
# NABIL_QUALIFY_RAG_CONTEXT_MAX_CHARS=8000

# Dashboard /usage — referência em GiB para o arco “memória Ollama vs máquina” (ex.: 32 no Mac)
# DASHBOARD_OLLAMA_MEMORY_REFERENCE_GIB=32

# Paths (relative to featureLLM or absolute)
DATA_DIR=./data

# Local STT (Whisper / faster-whisper) — POST /audio/transcribe, /audio/ask
# WHISPER_ENABLED=true
# WHISPER_MODEL_SIZE=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=pt
# WHISPER_BEAM_SIZE=5
# WHISPER_VAD_FILTER=true
# WHISPER_DOWNLOAD_ROOT=/absolute/path/to/whisper/cache
# AUDIO_MAX_BYTES=26214400
# AUDIO_TEMP_SUBDIR=audio_tmp

# Optional: override library path for a project (sources = content + flow map)
# BIKEANJOALL_2026_SOURCES=/path/to/2026b_bikeanjoAll_dbPrisma/bibliotecaConteudoLLM,/path/to/2026b_bikeanjoAll_dbPrisma/mapaFluxosLLM
# WEBPLACECC_SOURCES=/path/to/webplacecc/bibliotecaLLM_webplacecc,/path/to/webplacecc/mapaFluxosLLM
# Webplace internal: dev notes + batch tools — default paths in seed_webplace.py under featureLLM/project_library/webplace/
# WEBPLACE_SOURCES=/abs/path/fluxosLLM,/abs/path/bibliotecaConteudoLLM
# Chinese Learning (chineseLearning repo): markdown RAG
# CHINESE_LEARNING_SOURCES=/Users/you/Documents/projects/chineseLearning/rag_knowledge
